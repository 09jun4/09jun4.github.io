rules_version = '2';
// 픽셀 포지 — Firestore 보안 규칙.
// Firebase console > Firestore Database > 규칙 탭에 이 내용을 붙여 넣고 "게시"하세요.
// 지금은 사이트 프로젝트(chiikawa-tobatsu)를 같이 써요. 그 프로젝트의 기존 규칙은 지우지 말고,
// 아래 match /pixel_forge_users 블록만 다른 match 블록 옆에 추가하세요. (사이트 firestore.rules 에도 들어 있어요)
service cloud.firestore {
  match /databases/{database}/documents {
    // 개인 저장 데이터: 본인만 읽고 쓸 수 있어요.
    match /pixel_forge_users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'updatedAt'])
        && request.resource.data.save is string
        && request.resource.data.save.size() < 400000;
    }

    // 픽셀 포지 웨이브 랭킹: 누구나 읽기, 본인 기록만 쓰기 (닉네임 2~12자)
    match /pixel_forge_rank/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && (request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'wave', 'power', 'label', 'snap', 'updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 12
        && request.resource.data.wave is int && request.resource.data.wave >= 0 && request.resource.data.wave <= 100000
        && request.resource.data.power is number
        && request.resource.data.label is string && request.resource.data.label.size() <= 30
        && request.resource.data.snap is string && request.resource.data.snap.size() < 20000;
    }
  }
}
