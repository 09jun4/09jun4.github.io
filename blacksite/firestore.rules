rules_version = '2';
// BLACKSITE — Firestore 보안 규칙.
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 통째로 붙여 넣고 "게시"하세요.
// 계정별 저장 데이터(설정·기록·열람한 로그)는 본인만 읽고 쓸 수 있어요. 랭킹은 없어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validRecord(r) {
      return r is map && r.keys().hasOnly(['bestTimeSec', 'clears'])
        && r.bestTimeSec is number && r.bestTimeSec >= 0 && r.bestTimeSec < 86400
        && r.clears is int && r.clears >= 0 && r.clears < 1000000;
    }

    match /users/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['settings', 'records', 'readLogs', 'updatedAt'])
        && (!('settings' in request.resource.data)
            || (request.resource.data.settings is map
                && request.resource.data.settings.keys().hasOnly(['graphics', 'audio', 'controls', 'display', 'keyBindings'])))
        && (!('records' in request.resource.data)
            || (request.resource.data.records is map
                && request.resource.data.records.keys().hasOnly(['easy', 'normal', 'hard'])
                && (!('easy' in request.resource.data.records) || validRecord(request.resource.data.records.easy))
                && (!('normal' in request.resource.data.records) || validRecord(request.resource.data.records.normal))
                && (!('hard' in request.resource.data.records) || validRecord(request.resource.data.records.hard))))
        && (!('readLogs' in request.resource.data)
            || (request.resource.data.readLogs is list && request.resource.data.readLogs.size() <= 50))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
    }
  }
}
