rules_version = '2';
// KF-21 BORAMAE — Firestore 보안 규칙.
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 통째로 붙여 넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // 관리자: 이메일 인증된 구글 계정 중, 소문자 이메일의 SHA-256이 아래 값과 같은 계정(주소 자체는 적지 않는다)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString() == 'c94452ff79ea035becf03e8b1575c2728bd33fd4fab06e92a8091383399f1991';
    }
    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 12 && n.matches('^[^\\s<>"\'`\\\\/]+$');
    }
    // 점수 범위 검증. 미션이 18개로 늘고 목표·점수식이 미션마다 달라서 점수식 자체는 규칙으로 검증하지 않는다(타입·범위만).
    function validMissionScore(score, time) {
      return score is int && score >= 0 && score <= 100000 && time is number && time >= 8 && time < 3600;
    }
    function validTotal(score, missions) {
      return score is int && score >= 0 && score <= 2000000 && missions is int && missions >= 1 && missions <= 18;
    }

    // 개인 저장(진행도·설정·닉네임): 본인만 읽고 쓴다.
    match /users/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['progress', 'settings', 'nickname', 'nickKey', 'updatedAt'])
        && (!('progress' in request.resource.data) || (request.resource.data.progress is string && request.resource.data.progress.size() < 20000))
        && (!('settings' in request.resource.data) || (request.resource.data.settings is string && request.resource.data.settings.size() < 5000))
        && (!('nickname' in request.resource.data) || validName(request.resource.data.nickname))
        && (!('nickKey' in request.resource.data) || (request.resource.data.nickKey is string && request.resource.data.nickKey.size() <= 40));
    }

    // 닉네임 중복 방지: 문서 id = 닉네임(소문자). 누구나 읽고, 비어 있을 때만 본인 것으로 만들고, 본인 것만 지운다.
    match /nicknames/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key.size() >= 2 && key.size() <= 40;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // 미션별 랭킹: 누구나 읽고, 본인 기록만 쓴다. 관리자는 부정 기록을 지울 수 있다.
    match /rankings/{mission}/entries/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid) || isAdmin();
      allow create, update: if signedIn(uid)
        && mission.matches('^c[1-5]m[1-4]$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'time', 'at'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.name)
        && validMissionScore(request.resource.data.score, request.resource.data.time)
        && request.resource.data.at == request.time;
    }

    // 캠페인별·전체 랭킹(scope = c1~c5 | overall): 합산 점수. 누구나 읽고, 본인 기록만 쓴다.
    match /rankTotals/{scope}/entries/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid) || isAdmin();
      allow create, update: if signedIn(uid)
        && scope in ['overall', 'c1', 'c2', 'c3', 'c4', 'c5']
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'missions', 'at'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.name)
        && validTotal(request.resource.data.score, request.resource.data.missions)
        && request.resource.data.at == request.time;
    }

    // 예전(미션 3개 시절) 랭킹: 읽기와 정리만 남긴다. 새 기록은 위 경로로 올라간다.
    match /rankings/{mission}/scores/{uid} {
      allow read: if true;
      allow delete: if signedIn(uid) || isAdmin();
    }
  }
}
